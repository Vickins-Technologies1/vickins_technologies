# Runtime
APP_ENV=production
PORT=8080
HTTP_ADDR=
APP_NAME=VornShield
FRONTEND_URL=https://v-guard.vickinstechnologies.com
CORS_ALLOWED_ORIGINS=https://v-guard.vickinstechnologies.com

# Database
MONGO_URI=
MONGO_DATABASE=vguard

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Payments
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

# Proxy control plane
PROXY_PUBLIC_HOST=v-guard.vickinstechnologies.com
PROXY_HTTP_PORT=3128
PROXY_SOCKS_PORT=1080
PROXY_RATE_BYTES_PER_SEC=1048576
CREDIT_PER_GB=1
PROXY_RUNTIME_DIR=/tmp/v-guard/proxy
PROXY_USERS_PATH=/tmp/v-guard/proxy/users.txt
PROXY_HTTP_CONFIG_PATH=/tmp/v-guard/proxy/3proxy.cfg
PROXY_SOCKS_CONFIG_PATH=/tmp/v-guard/proxy/danted.conf
PROXY_HTTP_RELOAD_COMMAND=
PROXY_SOCKS_RELOAD_COMMAND=

# Optional bootstrap admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=VornShield Admin
